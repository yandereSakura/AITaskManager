# Базовый образ с Node.js
FROM node:20-slim

# Рабочая директория внутри контейнера
WORKDIR /app

# Сначала копируем только package.json — это ускоряет повторные сборки
COPY package*.json ./

# Устанавливаем зависимости
RUN npm install --production

# Копируем весь остальной код backend
COPY . .

# Порт, который будет слушать приложение внутри контейнера
EXPOSE 5000

# Команда запуска сервера при старте контейнера
CMD ["node", "index.js"]